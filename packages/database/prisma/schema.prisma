// Prisma schema — POS SaaS Multi-tenant
// Fase 1: Arquitectura y planificación. Ver docs/ARCHITECTURE.md para el diseño completo.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPERADMIN // Staff del SaaS (soporte multi-tenant, sin tenantId)
  OWNER // Dueño del comercio (tenant)
  ADMIN // Administrador del tenant
  MANAGER // Encargado de local
  CASHIER // Cajero
}

enum ProductType {
  SIMPLE
  VARIABLE
  BUNDLE
}

enum VatCondition {
  IVA_21
  IVA_10_5
  IVA_0
  EXENTO
  NO_GRAVADO
}

enum OrderSource {
  POS
  ONLINE
}

enum OrderStatus {
  OPEN
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  TRANSFER
  MERCADOPAGO
  ACCOUNT_CREDIT
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  INCOME
  EXPENSE
}

enum InvoiceType {
  FACTURA_A
  FACTURA_B
  FACTURA_C
  NOTA_CREDITO_A
  NOTA_CREDITO_B
  NOTA_CREDITO_C
  TICKET_NO_FISCAL
}

enum InvoiceStatus {
  PENDING
  AUTHORIZED
  REJECTED
  ERROR
}

enum SyncEntityType {
  PRODUCT_STOCK
  ORDER
  CATEGORY
  PRICE
}

enum SyncDirection {
  POS_TO_WOO
  WOO_TO_POS
}

enum SyncStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ──────────────────────────────────────────────────────────────────────────
// CORE / TENANCY
// ──────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  planTier  String   @default("standard")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  stores          Store[]
  categories      Category[]
  products        Product[]
  productVariants ProductVariant[]
  stockLevels     StockLevel[]
  customers       Customer[]
  syncQueue       SyncQueue[]
}

model User {
  id           String      @id @default(cuid())
  tenantId     String?
  tenant       Tenant?     @relation(fields: [tenantId], references: [id])
  email        String      @unique
  passwordHash String
  fullName     String
  role         UserRole    @default(CASHIER)
  isActive     Boolean     @default(true)
  storeAccess  Store[]     @relation("UserStores")
  cashShifts   CashShift[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId])
}

model Store {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  name              String
  address           String?
  afipPointOfSale   Int?
  afipCredential    AfipCredential?
  wooCommerceConfig WooCommerceConfig?
  cashRegisters     CashRegister[]
  stockLevels       StockLevel[]
  orders            Order[]
  users             User[]             @relation("UserStores")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// CAJA
// ──────────────────────────────────────────────────────────────────────────

model CashRegister {
  id        String      @id @default(cuid())
  storeId   String
  store     Store       @relation(fields: [storeId], references: [id])
  name      String
  isActive  Boolean     @default(true)
  shifts    CashShift[]
  createdAt DateTime    @default(now())

  @@index([storeId])
}

model CashShift {
  id             String          @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister    @relation(fields: [cashRegisterId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  openingAmount  Decimal         @db.Decimal(12, 2)
  closingAmount  Decimal?        @db.Decimal(12, 2)
  expectedAmount Decimal?        @db.Decimal(12, 2)
  difference     Decimal?        @db.Decimal(12, 2)
  status         CashShiftStatus @default(OPEN)
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  movements      CashMovement[]
  orders         Order[]

  @@index([cashRegisterId])
  @@index([userId])
}

model CashMovement {
  id          String           @id @default(cuid())
  cashShiftId String
  cashShift   CashShift        @relation(fields: [cashShiftId], references: [id])
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  reason      String
  createdAt   DateTime         @default(now())

  @@index([cashShiftId])
}

// ──────────────────────────────────────────────────────────────────────────
// CATÁLOGO
// ──────────────────────────────────────────────────────────────────────────

model Category {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  name          String
  parentId      String?
  parent        Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryToCategory")
  products      Product[]
  wooCategoryId Int?
  createdAt     DateTime   @default(now())

  @@index([tenantId])
}

model Product {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id])
  sku          String
  barcode      String?
  name         String
  description  String?
  type         ProductType  @default(SIMPLE)
  costPrice    Decimal      @default(0) @db.Decimal(12, 2)
  price        Decimal      @db.Decimal(12, 2)
  vatCondition VatCondition @default(IVA_21)
  trackStock   Boolean      @default(true)
  isActive     Boolean      @default(true)
  wooProductId Int?

  variants         ProductVariant[]
  stockLevels      StockLevel[]
  orderItems       OrderItem[]
  bundleComponents BundleItem[]     @relation("BundleComponent")
  bundleItems      BundleItem[]     @relation("BundleParent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
}

// tenantId está denormalizado desde Product para poder exigir unicidad de
// sku/barcode a nivel de tenant (no solo por producto) y para habilitar RLS
// directo sobre esta tabla, igual que en Product.
model ProductVariant {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  sku            String
  barcode        String?
  attributes     Json // { "color": "Rojo", "talle": "M" }
  price          Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  wooVariationId Int?

  stockLevels           StockLevel[]
  orderItems            OrderItem[]
  bundleComponentUsages BundleItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([productId])
}

// Combos/bundles: BundleItem une un Product "contenedor" (type=BUNDLE) con sus
// componentes. componentVariantId es opcional: si el combo requiere una
// variante específica del componente (ej. "Mate Imperial - Verde"), se fija
// acá; si no, el componente se resuelve a nivel de producto simple.
model BundleItem {
  id                 String          @id @default(cuid())
  bundleProductId    String
  bundleProduct      Product         @relation("BundleParent", fields: [bundleProductId], references: [id])
  componentProductId String
  componentProduct   Product         @relation("BundleComponent", fields: [componentProductId], references: [id])
  componentVariantId String?
  componentVariant   ProductVariant? @relation(fields: [componentVariantId], references: [id])
  quantity           Decimal         @default(1) @db.Decimal(12, 3)

  @@unique([bundleProductId, componentProductId])
}

// Stock físico por local. product XOR variant debe estar seteado (regla de
// negocio, no expresable en Prisma). Los combos (type=BUNDLE) no tienen fila
// propia acá — su disponibilidad se calcula en tiempo real a partir del
// stock de sus componentes (ver apps/api/src/stock/stock.service.ts).
model StockLevel {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  storeId          String
  store            Store           @relation(fields: [storeId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  quantity         Decimal         @default(0) @db.Decimal(12, 3)
  reservedQuantity Decimal         @default(0) @db.Decimal(12, 3)
  minAlertStock    Decimal?        @db.Decimal(12, 3)
  updatedAt        DateTime        @updatedAt

  @@unique([storeId, productId, variantId])
  @@index([tenantId, storeId])
}

// ──────────────────────────────────────────────────────────────────────────
// VENTAS
// ──────────────────────────────────────────────────────────────────────────

model Customer {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  docType         String? // DNI, CUIT
  docNumber       String?
  name            String
  email           String?
  phone           String?
  fiscalCondition String? // Consumidor Final, Responsable Inscripto, Monotributo, Exento
  accountBalance  Decimal  @default(0) @db.Decimal(12, 2) // cuenta corriente
  orders          Order[]
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

model Order {
  id             String      @id @default(cuid())
  tenantId       String
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id])
  cashShiftId    String?
  cashShift      CashShift?  @relation(fields: [cashShiftId], references: [id])
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  source         OrderSource @default(POS)
  status         OrderStatus @default(OPEN)
  subtotal       Decimal     @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(12, 2)
  surchargeTotal Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  wooOrderId     Int?

  items    OrderItem[]
  payments Payment[]
  invoice  Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([storeId])
  @@index([wooOrderId])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  description    String // snapshot del nombre al momento de la venta
  quantity       Decimal         @db.Decimal(12, 3)
  unitPrice      Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  vatRate        Decimal         @db.Decimal(5, 2) // snapshot de alícuota aplicada
  vatAmount      Decimal         @db.Decimal(12, 2)
  lineTotal      Decimal         @db.Decimal(12, 2)

  @@index([orderId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // nro de operación / cupón / últimos 4 dígitos
  createdAt DateTime      @default(now())

  @@index([orderId])
}

// ──────────────────────────────────────────────────────────────────────────
// FISCAL (AFIP)
// ──────────────────────────────────────────────────────────────────────────

model Invoice {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  type              InvoiceType
  pointOfSale       Int
  voucherNumber     Int?
  cae               String?
  caeExpirationDate DateTime?
  qrData            String?       @db.Text
  status            InvoiceStatus @default(PENDING)
  afipResponseRaw   Json?
  errorMessage      String?
  issuedAt          DateTime?
  createdAt         DateTime      @default(now())

  @@index([status])
}

model AfipCredential {
  id               String    @id @default(cuid())
  storeId          String    @unique
  store            Store     @relation(fields: [storeId], references: [id])
  cuit             String
  environment      String    @default("homologacion") // homologacion | produccion
  certificate      String    @db.Text // referencia/cifrado, no texto plano en prod
  privateKey       String    @db.Text // referencia/cifrado, no texto plano en prod
  lastTaRequestAt  DateTime?
  taToken          String?   @db.Text
  taSign           String?   @db.Text
  taExpirationTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────────────────
// INTEGRACIÓN WOOCOMMERCE
// ──────────────────────────────────────────────────────────────────────────

model WooCommerceConfig {
  id             String    @id @default(cuid())
  storeId        String    @unique
  store          Store     @relation(fields: [storeId], references: [id])
  siteUrl        String
  consumerKey    String    @db.Text // cifrado
  consumerSecret String    @db.Text // cifrado
  webhookSecret  String
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SyncQueue {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  entityType  SyncEntityType
  direction   SyncDirection
  entityId    String // id local o remoto según dirección
  payload     Json
  status      SyncStatus     @default(PENDING)
  attempts    Int            @default(0)
  maxAttempts Int            @default(5)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([tenantId, status])
}
