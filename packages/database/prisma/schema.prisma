// Prisma schema — POS SaaS Multi-tenant
// Fase 1: Arquitectura y planificación. Ver docs/ARCHITECTURE.md para el diseño completo.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPERADMIN // Staff del SaaS (soporte multi-tenant, sin tenantId)
  OWNER // Dueño del comercio (tenant)
  ADMIN // Administrador del tenant
  MANAGER // Encargado de local
  CASHIER // Cajero
}

enum ProductType {
  SIMPLE
  VARIABLE
  BUNDLE
}

enum VatCondition {
  IVA_21
  IVA_10_5
  IVA_0
  EXENTO
  NO_GRAVADO
}

enum OrderSource {
  POS
  ONLINE
}

enum OrderStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  MERCADO_PAGO
  CURRENT_ACCOUNT
}

enum CashRegisterStatus {
  ACTIVE
  INACTIVE
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  INFLOW
  OUTFLOW
}

enum InvoiceType {
  FACTURA_A
  FACTURA_B
  FACTURA_C
  NOTA_CREDITO_A
  NOTA_CREDITO_B
  NOTA_CREDITO_C
  TICKET_X
}

enum InvoiceStatus {
  ISSUED
  REJECTED
  CANCELLED
}

enum CustomerDocType {
  CUIT
  DNI
  PASAPORTE
  FINAL_CONSUMER
}

enum CustomerTaxCondition {
  CONSUMIDOR_FINAL
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
}

enum FiscalTaxCondition {
  MONOTRIBUTO
  RESPONSABLE_INSCRIPTO
  EXENTO
}

enum SyncEntityType {
  PRODUCT_STOCK
  ORDER
  CATEGORY
  PRICE
}

enum SyncDirection {
  POS_TO_WOO
  WOO_TO_POS
}

enum SyncStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ──────────────────────────────────────────────────────────────────────────
// CORE / TENANCY
// ──────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  planTier  String   @default("standard")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  stores          Store[]
  categories      Category[]
  products        Product[]
  productVariants ProductVariant[]
  stockLevels     StockLevel[]
  cashRegisters   CashRegister[]
  cashShifts      CashShift[]
  cashMovements   CashMovement[]
  orders          Order[]
  orderItems      OrderItem[]
  payments        Payment[]
  invoices        Invoice[]
  fiscalConfigs   FiscalConfig[]
  customers       Customer[]
  syncQueue       SyncQueue[]
}

model User {
  id            String         @id @default(cuid())
  tenantId      String?
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  email         String         @unique
  passwordHash  String
  fullName      String
  role          UserRole       @default(CASHIER)
  isActive      Boolean        @default(true)
  storeAccess   Store[]        @relation("UserStores")
  cashShifts    CashShift[]
  cashMovements CashMovement[]
  orders        Order[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
}

model Store {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  name              String
  address           String?
  fiscalConfig      FiscalConfig?
  wooCommerceConfig WooCommerceConfig?
  cashRegisters     CashRegister[]
  cashShifts        CashShift[]
  stockLevels       StockLevel[]
  orders            Order[]
  invoices          Invoice[]
  users             User[]             @relation("UserStores")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// CAJA
// ──────────────────────────────────────────────────────────────────────────

model CashRegister {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  storeId   String
  store     Store              @relation(fields: [storeId], references: [id])
  name      String
  status    CashRegisterStatus @default(ACTIVE)
  shifts    CashShift[]
  createdAt DateTime           @default(now())

  @@index([tenantId])
  @@index([storeId])
}

// Solo puede existir un CashShift con status=OPEN por cashRegisterId a la
// vez — se aplica con un índice único parcial en Postgres (no expresable en
// schema.prisma), ver prisma/migrations/..._cash_shifts.
model CashShift {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister    @relation(fields: [cashRegisterId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  initialAmount  Decimal         @db.Decimal(12, 2)
  actualCash     Decimal?        @db.Decimal(12, 2)
  expectedCash   Decimal?        @db.Decimal(12, 2)
  difference     Decimal?        @db.Decimal(12, 2)
  notes          String?
  status         CashShiftStatus @default(OPEN)
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  movements      CashMovement[]
  orders         Order[]

  @@index([tenantId])
  @@index([cashRegisterId])
  @@index([userId])
}

model CashMovement {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  cashShiftId String
  cashShift   CashShift        @relation(fields: [cashShiftId], references: [id])
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  reason      String
  createdAt   DateTime         @default(now())

  @@index([tenantId])
  @@index([cashShiftId])
}

// ──────────────────────────────────────────────────────────────────────────
// CATÁLOGO
// ──────────────────────────────────────────────────────────────────────────

model Category {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  name          String
  parentId      String?
  parent        Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryToCategory")
  products      Product[]
  wooCategoryId Int?
  createdAt     DateTime   @default(now())

  @@index([tenantId])
}

model Product {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id])
  sku          String
  barcode      String?
  name         String
  description  String?
  type         ProductType  @default(SIMPLE)
  costPrice    Decimal      @default(0) @db.Decimal(12, 2)
  price        Decimal      @db.Decimal(12, 2)
  vatCondition VatCondition @default(IVA_21)
  trackStock   Boolean      @default(true)
  isActive     Boolean      @default(true)
  wooProductId Int?

  variants                       ProductVariant[]
  stockLevels                    StockLevel[]
  orderItems                     OrderItem[]
  orderItemBundleComponentUsages OrderItemBundleComponent[]
  bundleComponents               BundleItem[]               @relation("BundleComponent")
  bundleItems                    BundleItem[]               @relation("BundleParent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
}

// tenantId está denormalizado desde Product para poder exigir unicidad de
// sku/barcode a nivel de tenant (no solo por producto) y para habilitar RLS
// directo sobre esta tabla, igual que en Product.
model ProductVariant {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  sku            String
  barcode        String?
  attributes     Json // { "color": "Rojo", "talle": "M" }
  price          Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  wooVariationId Int?

  stockLevels                    StockLevel[]
  orderItems                     OrderItem[]
  orderItemBundleComponentUsages OrderItemBundleComponent[]
  bundleComponentUsages          BundleItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([productId])
}

// Combos/bundles: BundleItem une un Product "contenedor" (type=BUNDLE) con sus
// componentes. componentVariantId es opcional: si el combo requiere una
// variante específica del componente (ej. "Mate Imperial - Verde"), se fija
// acá; si no, el componente se resuelve a nivel de producto simple.
model BundleItem {
  id                 String          @id @default(cuid())
  bundleProductId    String
  bundleProduct      Product         @relation("BundleParent", fields: [bundleProductId], references: [id])
  componentProductId String
  componentProduct   Product         @relation("BundleComponent", fields: [componentProductId], references: [id])
  componentVariantId String?
  componentVariant   ProductVariant? @relation(fields: [componentVariantId], references: [id])
  quantity           Decimal         @default(1) @db.Decimal(12, 3)

  @@unique([bundleProductId, componentProductId])
}

// Stock físico por local. product XOR variant debe estar seteado (regla de
// negocio, no expresable en Prisma). Los combos (type=BUNDLE) no tienen fila
// propia acá — su disponibilidad se calcula en tiempo real a partir del
// stock de sus componentes (ver apps/api/src/stock/stock.service.ts).
model StockLevel {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  storeId          String
  store            Store           @relation(fields: [storeId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  quantity         Decimal         @default(0) @db.Decimal(12, 3)
  reservedQuantity Decimal         @default(0) @db.Decimal(12, 3)
  minAlertStock    Decimal?        @db.Decimal(12, 3)
  updatedAt        DateTime        @updatedAt

  @@unique([storeId, productId, variantId])
  @@index([tenantId, storeId])
}

// ──────────────────────────────────────────────────────────────────────────
// VENTAS
// ──────────────────────────────────────────────────────────────────────────

model Customer {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  docType        CustomerDocType      @default(FINAL_CONSUMER)
  docNumber      String?
  name           String
  businessName   String? // razón social — se usa en Factura A a Responsable Inscripto
  taxCondition   CustomerTaxCondition @default(CONSUMIDOR_FINAL)
  address        String?
  email          String?
  phone          String?
  accountBalance Decimal              @default(0) @db.Decimal(12, 2) // cuenta corriente
  orders         Order[]
  invoices       Invoice[]
  createdAt      DateTime             @default(now())

  @@index([tenantId])
}

// orderNumber es secuencial por (tenantId, storeId) — se calcula dentro de
// la misma transacción que crea la orden (MAX+1) y se protege con el
// @@unique de abajo: si dos cajas concurrentes calculan el mismo número, la
// segunda transacción falla con P2002 y el servicio reintenta desde cero
// (ver OrdersService.create). No es el número de comprobante fiscal — ese
// lo asigna AFIP en Sprint 6 vía Invoice.voucherNumber.
model Order {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id])
  cashShiftId    String?
  cashShift      CashShift?  @relation(fields: [cashShiftId], references: [id])
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  orderNumber    Int
  source         OrderSource @default(POS)
  status         OrderStatus @default(COMPLETED)
  subtotal       Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  notes          String?
  wooOrderId     Int?

  items    OrderItem[]
  payments Payment[]
  invoice  Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, storeId, orderNumber])
  @@index([tenantId])
  @@index([storeId])
  @@index([wooOrderId])
}

// Todos los campos "snapshot" (productName, sku, unitPrice, unitCost,
// vatCondition/taxRate) se copian del catálogo al momento de la venta y ya
// no cambian, aunque el producto se edite o borre después — la orden
// refleja lo que realmente se vendió, no el estado actual del catálogo.
model OrderItem {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  productType    ProductType
  productName    String
  sku            String
  quantity       Decimal         @db.Decimal(12, 3)
  unitPrice      Decimal         @db.Decimal(12, 2)
  unitCost       Decimal         @db.Decimal(12, 2)
  vatCondition   VatCondition
  taxRate        Decimal         @db.Decimal(5, 2) // alícuota numérica snapshot (21, 10.5, 0)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  subtotal       Decimal         @db.Decimal(12, 2) // quantity * unitPrice, antes del descuento
  total          Decimal         @db.Decimal(12, 2) // subtotal - discountAmount

  bundleComponents OrderItemBundleComponent[]

  @@index([tenantId])
  @@index([orderId])
}

// Snapshot de qué componentes (y cuánto de cada uno) se descontaron del
// stock físico al vender un OrderItem de tipo BUNDLE — trazabilidad
// histórica de costo/stock aunque el combo cambie de composición después.
model OrderItemBundleComponent {
  id                 String          @id @default(cuid())
  orderItemId        String
  orderItem          OrderItem       @relation(fields: [orderItemId], references: [id])
  componentProductId String
  componentProduct   Product         @relation(fields: [componentProductId], references: [id])
  componentVariantId String?
  componentVariant   ProductVariant? @relation(fields: [componentVariantId], references: [id])
  componentName      String
  quantity           Decimal         @db.Decimal(12, 3) // ya multiplicada por la cantidad vendida del combo

  @@index([orderItemId])
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // nro de operación / cupón / últimos 4 dígitos
  createdAt DateTime      @default(now())

  @@index([tenantId])
  @@index([orderId])
}

// ──────────────────────────────────────────────────────────────────────────
// FISCAL (AFIP)
// ──────────────────────────────────────────────────────────────────────────

// A diferencia de Order (que se crea siempre, venta contado), Invoice solo
// se crea DESPUÉS de tener una respuesta de AFIP (o de asignar el número de
// Ticket X) — nunca queda un Invoice "a medias" mientras se espera esa
// respuesta. Ver docs/afip.md y apps/api/src/afip/ para el detalle del
// intercambio WSAA/WSFE.
model Invoice {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id])
  orderId      String        @unique
  order        Order         @relation(fields: [orderId], references: [id])
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  invoiceType  InvoiceType
  ptoVta       Int
  cbteNro      Int?
  cae          String?
  caeVto       DateTime?
  afipQrUrl    String?       @db.Text
  status       InvoiceStatus
  subtotalNeto Decimal       @db.Decimal(12, 2)
  vatAmount    Decimal       @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  afipResponse Json?
  errorMessage String?
  issuedAt     DateTime?
  createdAt    DateTime      @default(now())

  @@unique([storeId, invoiceType, cbteNro])
  @@index([tenantId])
  @@index([storeId])
  @@index([status])
}

// El Ticket de Acceso (WSAA) NO se persiste acá — vive en Redis con TTL
// (ver apps/api/src/afip/afip-auth.service.ts), así que este modelo son
// solo los datos de identidad fiscal + credenciales, no estado de sesión.
model FiscalConfig {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  storeId           String             @unique
  store             Store              @relation(fields: [storeId], references: [id])
  cuit              String
  taxCondition      FiscalTaxCondition
  grossIncomeNumber String?
  activityStartDate DateTime?
  ptoVta            Int
  crtCertificate    String             @db.Text // referencia/cifrado, no texto plano en prod
  keyCertificate    String             @db.Text // referencia/cifrado, no texto plano en prod
  isProduction      Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, ptoVta])
  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// INTEGRACIÓN WOOCOMMERCE
// ──────────────────────────────────────────────────────────────────────────

model WooCommerceConfig {
  id             String    @id @default(cuid())
  storeId        String    @unique
  store          Store     @relation(fields: [storeId], references: [id])
  siteUrl        String
  consumerKey    String    @db.Text // cifrado
  consumerSecret String    @db.Text // cifrado
  webhookSecret  String
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SyncQueue {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  entityType  SyncEntityType
  direction   SyncDirection
  entityId    String // id local o remoto según dirección
  payload     Json
  status      SyncStatus     @default(PENDING)
  attempts    Int            @default(0)
  maxAttempts Int            @default(5)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([tenantId, status])
}
