// Prisma schema — POS SaaS Multi-tenant
// Fase 1: Arquitectura y planificación. Ver docs/ARCHITECTURE.md para el diseño completo.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPERADMIN // Staff del SaaS (soporte multi-tenant, sin tenantId)
  OWNER // Dueño del comercio (tenant)
  ADMIN // Administrador del tenant
  MANAGER // Encargado de local
  CASHIER // Cajero
}

// Cómo se fija el precio de un combo. MANUAL es el comportamiento histórico
// (alguien escribe el precio y queda congelado); DERIVED lo ata a sus
// componentes. Ver Product.bundlePricingMode.
enum BundlePricingMode {
  MANUAL
  DERIVED
}

enum ProductType {
  SIMPLE
  VARIABLE
  BUNDLE
}

enum VatCondition {
  IVA_21
  IVA_10_5
  IVA_0
  EXENTO
  NO_GRAVADO
}

enum OrderSource {
  POS
  ONLINE
}

enum OrderStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  MERCADO_PAGO
  CURRENT_ACCOUNT
}

enum CashRegisterStatus {
  ACTIVE
  INACTIVE
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  INFLOW
  OUTFLOW
}

enum InvoiceType {
  FACTURA_A
  FACTURA_B
  FACTURA_C
  NOTA_CREDITO_A
  NOTA_CREDITO_B
  NOTA_CREDITO_C
  TICKET_X
}

enum InvoiceStatus {
  ISSUED
  REJECTED
  CANCELLED
}

enum CustomerDocType {
  CUIT
  DNI
  PASAPORTE
  FINAL_CONSUMER
}

enum CustomerTaxCondition {
  CONSUMIDOR_FINAL
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
}

enum FiscalTaxCondition {
  MONOTRIBUTO
  RESPONSABLE_INSCRIPTO
  EXENTO
}

enum SyncEntityType {
  PRODUCT
  STOCK
  ORDER
}

enum SyncDirection {
  OUTBOUND_TO_WOO
  INBOUND_FROM_WOO
  OUTBOUND_TO_TIENDANUBE
  INBOUND_FROM_TIENDANUBE
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WooSyncStatus {
  SYNCED
  PENDING
  ERROR
  IGNORED
}

// Espeja los estados de una suscripción (preapproval) de Mercado Pago, más
// TRIAL que es propio nuestro (MP no conoce el período de prueba).
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

// Qué hacer cuando un tenant tiene la suscripción vencida. Es por tenant y
// no una constante global a propósito: el default WARN_ONLY es la política
// comercial elegida (nunca trabar a un comercio en el mostrador), pero deja
// poder endurecerla puntualmente con un cliente que abusa, sin tocar código
// ni redeployar. Ver SubscriptionGuard.
enum EnforcementPolicy {
  WARN_ONLY // solo banner de aviso, no bloquea nada
  READ_ONLY // deja entrar, consultar y exportar; no deja cobrar ni facturar
  BLOCK     // no deja usar el sistema
}

// ──────────────────────────────────────────────────────────────────────────
// CORE / TENANCY
// ──────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // "standard" | "demo". Arrancó sin usarse (campo muerto desde el init) y
  // ahora distingue un tenant real de un sandbox efímero — ver DemoModule.
  planTier  String   @default("standard")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Solo para planTier="demo": cuándo se borra el sandbox (job de limpieza,
  // ver DemoCleanupQueue). null en tenants reales. Deliberadamente separado
  // de trialEndsAt: ese es un dato COMERCIAL que /platform puede editar y que
  // graceDays extiende; este es un dato de CICLO DE VIDA que solo el job de
  // purga lee. Mezclarlos dejaría que extender el trial de alguien programe
  // sin querer el borrado de sus datos, o viceversa.
  demoExpiresAt DateTime?

  // ── Suscripción / licencia ──────────────────────────────────────────────
  // subscriptionStatus refleja lo que dice Mercado Pago (la fuente
  // autoritativa), NO el vencimiento: un tenant puede estar AUTHORIZED en MP
  // y aun así tener currentPeriodEnd en el pasado si el último débito falló.
  // El estado *efectivo* se deriva al leer con subscription-status.util.ts —
  // no hay ningún cron que "marque vencidos", justamente para que no pueda
  // fallar en silencio y dejar clientes cobrados de más o de menos.
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime? // hasta cuándo está paga la suscripción
  mpPreapprovalId    String?            @unique
  enforcementPolicy  EnforcementPolicy  @default(WARN_ONLY)
  monthlyAmount      Decimal?           @db.Decimal(12, 2)
  // Copia del email del OWNER al dar de alta. Existe para que el panel de
  // plataforma pueda mostrar a quién reclamarle sin necesidad de leer "User"
  // cross-tenant — esa tabla guarda passwordHash y su RLS NO se amplía.
  contactEmail       String?

  subscriptionEvents SubscriptionEvent[]

  users              User[]
  stores             Store[]
  categories         Category[]
  products           Product[]
  productVariants    ProductVariant[]
  stockLevels        StockLevel[]
  cashRegisters      CashRegister[]
  cashShifts         CashShift[]
  cashMovements      CashMovement[]
  orders             Order[]
  orderItems         OrderItem[]
  payments           Payment[]
  invoices           Invoice[]
  fiscalConfigs      FiscalConfig[]
  customers          Customer[]
  syncLogs           SyncLog[]
  wooCommerceConfigs WooCommerceConfig[]
  tiendanubeConfigs  TiendanubeConfig[]
  discountPolicies   DiscountPolicy[]
  auditLogs          AuditLog[]
  customerAccountMovements CustomerAccountMovement[]
  suppliers          Supplier[]
  purchases          Purchase[]
  purchaseItems      PurchaseItem[]

  @@index([planTier, demoExpiresAt])
}

model User {
  id            String         @id @default(cuid())
  tenantId      String?
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  email         String         @unique
  passwordHash  String
  fullName      String
  role          UserRole       @default(CASHIER)
  isActive      Boolean        @default(true)
  storeAccess   Store[]        @relation("UserStores")
  cashShifts    CashShift[]
  cashMovements CashMovement[]
  orders        Order[]
  customerAccountMovements CustomerAccountMovement[]
  purchases     Purchase[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@index([tenantId])
}

model Store {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  name              String
  address           String?
  fiscalConfig      FiscalConfig?
  wooCommerceConfig WooCommerceConfig?
  tiendanubeConfig  TiendanubeConfig?
  cashRegisters     CashRegister[]
  cashShifts        CashShift[]
  stockLevels       StockLevel[]
  orders            Order[]
  invoices          Invoice[]
  users             User[]             @relation("UserStores")
  customerAccountMovements CustomerAccountMovement[]
  purchases         Purchase[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// CAJA
// ──────────────────────────────────────────────────────────────────────────

model CashRegister {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  storeId   String
  store     Store              @relation(fields: [storeId], references: [id])
  name      String
  status    CashRegisterStatus @default(ACTIVE)
  shifts    CashShift[]
  createdAt DateTime           @default(now())

  @@index([tenantId])
  @@index([storeId])
}

// Solo puede existir un CashShift con status=OPEN por cashRegisterId a la
// vez — se aplica con un índice único parcial en Postgres (no expresable en
// schema.prisma), ver prisma/migrations/..._cash_shifts.
model CashShift {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister    @relation(fields: [cashRegisterId], references: [id])
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  initialAmount  Decimal         @db.Decimal(12, 2)
  actualCash     Decimal?        @db.Decimal(12, 2)
  expectedCash   Decimal?        @db.Decimal(12, 2)
  difference     Decimal?        @db.Decimal(12, 2)
  notes          String?
  status         CashShiftStatus @default(OPEN)
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  movements      CashMovement[]
  orders         Order[]
  customerAccountMovements CustomerAccountMovement[]

  @@index([tenantId])
  @@index([cashRegisterId])
  @@index([userId])
}

model CashMovement {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  cashShiftId String
  cashShift   CashShift        @relation(fields: [cashShiftId], references: [id])
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  reason      String
  createdAt   DateTime         @default(now())

  @@index([tenantId])
  @@index([cashShiftId])
}

// ──────────────────────────────────────────────────────────────────────────
// CATÁLOGO
// ──────────────────────────────────────────────────────────────────────────

model Category {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  name          String
  parentId      String?
  parent        Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryToCategory")
  products      Product[]
  wooCategoryId Int?
  createdAt     DateTime   @default(now())

  @@index([tenantId])
}

model Product {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  sku           String
  barcode       String?
  name          String
  description   String?
  // Ruta relativa servida por la API (ej. "/uploads/products/<id>.webp"),
  // no una URL absoluta — el front arma la URL completa con NEXT_PUBLIC_API_URL
  // (ver apps/pos-web/src/lib/api.ts). Así el valor guardado no queda atado
  // al host/puerto de un entorno en particular (dev vs Docker vs prod real).
  imageUrl      String?
  type          ProductType   @default(SIMPLE)
  costPrice     Decimal       @default(0) @db.Decimal(12, 2)
  price         Decimal       @db.Decimal(12, 2)
  vatCondition  VatCondition  @default(IVA_21)
  trackStock    Boolean       @default(true)
  isActive      Boolean       @default(true)
  wooProductId  Int?
  wooSyncStatus WooSyncStatus @default(IGNORED)
  wooLastSyncAt DateTime?
  // Tienda Nube necesita LOS DOS ids: del lado de ellos incluso un producto
  // simple tiene una variante, y la ruta de stock cuelga de ambos
  // (/products/:tnProductId/variants/:tnVariantId).
  tnProductId   Int?
  tnVariantId   Int?

  // Solo tienen sentido con type=BUNDLE. Con DERIVED, `price` deja de
  // escribirse a mano: lo recalcula BundlePricingService como la suma de los
  // componentes menos bundleDiscountPercent, cada vez que cambia el precio de
  // un componente o la composición del combo. `price` sigue siendo la única
  // fuente de verdad del precio (la lee el POS, la venta y el sync con las
  // tiendas online) — lo que cambia es quién la escribe.
  bundlePricingMode     BundlePricingMode @default(MANUAL)
  bundleDiscountPercent Decimal?          @db.Decimal(5, 2)

  variants                       ProductVariant[]
  stockLevels                    StockLevel[]
  orderItems                     OrderItem[]
  orderItemBundleComponentUsages OrderItemBundleComponent[]
  // Los dos lados de BundleItem, nombrados por lo que significan. Estaban al
  // revés: `bundleComponents` apuntaba a "los combos que contienen a este
  // producto", así que el include de la pantalla de combos traía siempre una
  // lista vacía y los componentes no se veían nunca. Son nombres de campo del
  // cliente de Prisma, no columnas: renombrarlos no necesita migración.
  bundleComponents               BundleItem[]               @relation("BundleParent")
  partOfBundles                  BundleItem[]               @relation("BundleComponent")
  purchaseItems                  PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
}

// tenantId está denormalizado desde Product para poder exigir unicidad de
// sku/barcode a nivel de tenant (no solo por producto) y para habilitar RLS
// directo sobre esta tabla, igual que en Product.
model ProductVariant {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  sku           String
  barcode       String?
  attributes    Json // { "color": "Rojo", "talle": "M" }
  price         Decimal?      @db.Decimal(12, 2)
  costPrice     Decimal?      @db.Decimal(12, 2)
  wooVariantId  Int?
  wooSyncStatus WooSyncStatus @default(IGNORED)
  wooLastSyncAt DateTime?
  tnProductId   Int?
  tnVariantId   Int?

  stockLevels                    StockLevel[]
  orderItems                     OrderItem[]
  orderItemBundleComponentUsages OrderItemBundleComponent[]
  bundleComponentUsages          BundleItem[]
  purchaseItems                  PurchaseItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([productId])
}

// Combos/bundles: BundleItem une un Product "contenedor" (type=BUNDLE) con sus
// componentes. componentVariantId es opcional: si el combo requiere una
// variante específica del componente (ej. "Mate Imperial - Verde"), se fija
// acá; si no, el componente se resuelve a nivel de producto simple.
model BundleItem {
  id                 String          @id @default(cuid())
  bundleProductId    String
  bundleProduct      Product         @relation("BundleParent", fields: [bundleProductId], references: [id])
  componentProductId String
  componentProduct   Product         @relation("BundleComponent", fields: [componentProductId], references: [id])
  componentVariantId String?
  componentVariant   ProductVariant? @relation(fields: [componentVariantId], references: [id])
  quantity           Decimal         @default(1) @db.Decimal(12, 3)

  @@unique([bundleProductId, componentProductId])
  // "¿Qué combos contienen este componente?" — la pregunta que hace
  // BundlePricingService en cada cambio de precio, incluida la actualización
  // masiva. Sin el índice sería un scan completo por producto tocado.
  @@index([componentProductId])
}

// Stock físico por local. product XOR variant debe estar seteado (regla de
// negocio, no expresable en Prisma). Los combos (type=BUNDLE) no tienen fila
// propia acá — su disponibilidad se calcula en tiempo real a partir del
// stock de sus componentes (ver apps/api/src/stock/stock.service.ts).
model StockLevel {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  storeId          String
  store            Store           @relation(fields: [storeId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  quantity         Decimal         @default(0) @db.Decimal(12, 3)
  reservedQuantity Decimal         @default(0) @db.Decimal(12, 3)
  minAlertStock    Decimal?        @db.Decimal(12, 3)
  updatedAt        DateTime        @updatedAt

  @@unique([storeId, productId, variantId])
  @@index([tenantId, storeId])
}

// ──────────────────────────────────────────────────────────────────────────
// VENTAS
// ──────────────────────────────────────────────────────────────────────────

model Customer {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  docType        CustomerDocType      @default(FINAL_CONSUMER)
  docNumber      String?
  name           String
  businessName   String? // razón social — se usa en Factura A a Responsable Inscripto
  taxCondition   CustomerTaxCondition @default(CONSUMIDOR_FINAL)
  address        String?
  email          String?
  phone          String?
  accountBalance Decimal              @default(0) @db.Decimal(12, 2) // cuenta corriente
  creditLimit    Decimal?             @db.Decimal(12, 2) // null = sin límite
  orders         Order[]
  invoices       Invoice[]
  accountMovements CustomerAccountMovement[]
  createdAt      DateTime             @default(now())

  @@index([tenantId])
}

enum AccountMovementType {
  CHARGE // venta a cuenta corriente
  PAYMENT // el cliente paga (parte de) su deuda
  ADJUSTMENT // corrección manual (OWNER/ADMIN)
  CHARGE_REVERSAL // se anula la venta que generó el cargo
}

// Ledger de cuenta corriente — accountBalance en Customer es un
// denormalizado calculado a partir de esto (siempre en la misma
// transacción que la fila, nunca por separado, ver CustomersService). amount
// es el delta CON SIGNO aplicado al saldo (positivo = aumenta la deuda,
// negativo = la reduce) — CHARGE siempre positivo, PAYMENT/CHARGE_REVERSAL
// siempre negativos, ADJUSTMENT puede ir en cualquier sentido (por eso no
// se puede inferir el signo solo de `type`, a diferencia de los otros tres).
model CustomerAccountMovement {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  customerId    String
  customer      Customer             @relation(fields: [customerId], references: [id])
  storeId       String?
  store         Store?               @relation(fields: [storeId], references: [id])
  type          AccountMovementType
  amount        Decimal              @db.Decimal(12, 2)
  balanceAfter  Decimal              @db.Decimal(12, 2)
  orderId       String?
  order         Order?               @relation(fields: [orderId], references: [id])
  cashShiftId   String?
  cashShift     CashShift?           @relation(fields: [cashShiftId], references: [id])
  paymentMethod PaymentMethod?
  reference     String?
  notes         String?
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  // Evita cobrar dos veces por un doble clic/reintento de red — ver
  // CustomersService.registerPayment.
  idempotencyKey String?
  createdAt     DateTime             @default(now())

  @@unique([tenantId, idempotencyKey])
  // Un solo cargo y una sola reversa por orden — no dos CHARGE para la
  // misma venta ni dos CHARGE_REVERSAL si se reintenta la anulación.
  @@unique([orderId, type])
  @@index([tenantId, customerId, createdAt])
}

// orderNumber es secuencial por (tenantId, storeId) — se calcula dentro de
// la misma transacción que crea la orden (MAX+1) y se protege con el
// @@unique de abajo: si dos cajas concurrentes calculan el mismo número, la
// segunda transacción falla con P2002 y el servicio reintenta desde cero
// (ver OrdersService.create). No es el número de comprobante fiscal — ese
// lo asigna AFIP en Sprint 6 vía Invoice.voucherNumber.
model Order {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id])
  cashShiftId    String?
  cashShift      CashShift?  @relation(fields: [cashShiftId], references: [id])
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  orderNumber    Int
  source         OrderSource @default(POS)
  status         OrderStatus @default(COMPLETED)
  subtotal       Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  notes          String?
  wooOrderId     Int?

  items    OrderItem[]
  payments Payment[]
  // Plural: una orden anulada tras facturarse tiene la factura original y su
  // nota de crédito. Para el caso corriente (obtener "la factura") usar el
  // helper de InvoicesService, que filtra los tipos NOTA_CREDITO_*.
  invoices Invoice[]
  accountMovements CustomerAccountMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, storeId, orderNumber])
  @@index([tenantId])
  @@index([storeId])
  @@index([wooOrderId])
}

// Todos los campos "snapshot" (productName, sku, unitPrice, unitCost,
// vatCondition/taxRate) se copian del catálogo al momento de la venta y ya
// no cambian, aunque el producto se edite o borre después — la orden
// refleja lo que realmente se vendió, no el estado actual del catálogo.
model OrderItem {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  productType    ProductType
  productName    String
  sku            String
  quantity       Decimal         @db.Decimal(12, 3)
  unitPrice      Decimal         @db.Decimal(12, 2)
  unitCost       Decimal         @db.Decimal(12, 2)
  vatCondition   VatCondition
  taxRate        Decimal         @db.Decimal(5, 2) // alícuota numérica snapshot (21, 10.5, 0)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  subtotal       Decimal         @db.Decimal(12, 2) // quantity * unitPrice, antes del descuento
  total          Decimal         @db.Decimal(12, 2) // subtotal - discountAmount

  bundleComponents OrderItemBundleComponent[]

  @@index([tenantId])
  @@index([orderId])
}

// Snapshot de qué componentes (y cuánto de cada uno) se descontaron del
// stock físico al vender un OrderItem de tipo BUNDLE — trazabilidad
// histórica de costo/stock aunque el combo cambie de composición después.
model OrderItemBundleComponent {
  id                 String          @id @default(cuid())
  orderItemId        String
  orderItem          OrderItem       @relation(fields: [orderItemId], references: [id])
  componentProductId String
  componentProduct   Product         @relation(fields: [componentProductId], references: [id])
  componentVariantId String?
  componentVariant   ProductVariant? @relation(fields: [componentVariantId], references: [id])
  componentName      String
  quantity           Decimal         @db.Decimal(12, 3) // ya multiplicada por la cantidad vendida del combo

  @@index([orderItemId])
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // nro de operación / cupón / últimos 4 dígitos
  createdAt DateTime      @default(now())

  @@index([tenantId])
  @@index([orderId])
}

// Tope de descuento que puede aplicar cada rol en el mostrador, por comercio.
//
// LA AUSENCIA DE FILA SIGNIFICA "SIN TOPE". Es deliberado: instalar esta
// versión no le cambia el comportamiento a ningún comercio que ya esté
// operando, y poner un límite es un acto explícito del dueño desde
// Configuración → Descuentos. La contra es que una instalación nueva arranca
// sin protección hasta que alguien la configure.
//
// El tope se valida en el backend (OrdersService), no solo en la pantalla: un
// cajero con la consola del navegador abierta puede mandar el POST que quiera.
model DiscountPolicy {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  role       UserRole
  // Porcentaje máximo sobre el bruto de la línea (0 = no puede descontar
  // nada, 100 = sin tope efectivo).
  maxPercent Decimal  @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, role])
  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// FISCAL (AFIP)
// ──────────────────────────────────────────────────────────────────────────

// A diferencia de Order (que se crea siempre, venta contado), Invoice solo
// se crea DESPUÉS de tener una respuesta de AFIP (o de asignar el número de
// Ticket X) — nunca queda un Invoice "a medias" mientras se espera esa
// respuesta. Ver docs/afip.md y apps/api/src/afip/ para el detalle del
// intercambio WSAA/WSFE.
model Invoice {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id])
  // NO es @unique: una orden anulada después de facturarse tiene DOS
  // comprobantes — la factura original y su nota de crédito. La unicidad
  // real que importa es @@unique([storeId, invoiceType, cbteNro]), que sigue
  // garantizando que no se repita un número dentro de cada tipo.
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id])
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  // Solo en notas de crédito: apunta a la factura que anulan. Es lo que
  // alimenta el nodo <CbtesAsoc> que exige WSFE, y lo que permite auditar
  // qué comprobante canceló a cuál.
  relatedInvoiceId String?    @unique
  relatedInvoice   Invoice?   @relation("CreditNoteOf", fields: [relatedInvoiceId], references: [id])
  creditNote       Invoice?   @relation("CreditNoteOf")
  invoiceType  InvoiceType
  ptoVta       Int
  cbteNro      Int?
  cae          String?
  caeVto       DateTime?
  afipQrUrl    String?       @db.Text
  status       InvoiceStatus
  subtotalNeto Decimal       @db.Decimal(12, 2)
  vatAmount    Decimal       @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  afipResponse Json?
  errorMessage String?
  issuedAt     DateTime?
  createdAt    DateTime      @default(now())

  @@unique([storeId, invoiceType, cbteNro])
  @@index([tenantId])
  @@index([storeId])
  @@index([status])
  @@index([orderId])
}

// El Ticket de Acceso (WSAA) NO se persiste acá — vive en Redis con TTL
// (ver apps/api/src/afip/afip-auth.service.ts), así que este modelo son
// solo los datos de identidad fiscal + credenciales, no estado de sesión.
model FiscalConfig {
  id                String             @id @default(cuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  storeId           String             @unique
  store             Store              @relation(fields: [storeId], references: [id])
  cuit              String
  taxCondition      FiscalTaxCondition
  grossIncomeNumber String?
  activityStartDate DateTime?
  ptoVta            Int
  crtCertificate    String             @db.Text // referencia/cifrado, no texto plano en prod
  keyCertificate    String             @db.Text // referencia/cifrado, no texto plano en prod
  isProduction      Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, ptoVta])
  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// INTEGRACIÓN WOOCOMMERCE (Sprint 7)
// ──────────────────────────────────────────────────────────────────────────

// tenantId está denormalizado (igual que FiscalConfig) para poder filtrar
// explícitamente en cada query — pero, a diferencia de FiscalConfig, esta
// tabla NO tiene RLS forzada todavía: el endpoint público de webhooks (ver
// apps/api/src/woocommerce/woo-webhook.controller.ts) necesita resolver un
// WooCommerceConfig por id SIN conocer el tenant de antemano (la request
// llega de WooCommerce, no de un usuario autenticado) — igual que
// withAuthLookupContext resuelve el email de login antes de saber el
// tenant. Extender ese mismo bypass a esta tabla agregaría una segunda
// política especial de RLS por una ganancia marginal; se prefiere dejarla
// en el mismo grupo que las demás tablas hijas pendientes de RLS por
// cascada (ver comentario en la migración ..._enable_row_level_security).
model WooCommerceConfig {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  storeId           String    @unique
  store             Store     @relation(fields: [storeId], references: [id])
  apiUrl            String
  consumerKey       String    @db.Text // referencia/cifrado, no texto plano en prod
  consumerSecret    String    @db.Text // referencia/cifrado, no texto plano en prod
  webhookSecret     String
  syncStockOutbound Boolean   @default(true)
  syncStockInbound  Boolean   @default(true)
  // Precio: solo saliente (POS -> WooCommerce) — no tiene sentido un
  // "inbound" simétrico al de stock, el precio de venta lo define el POS,
  // no la tienda online.
  syncPriceOutbound Boolean   @default(true)
  isActive          Boolean   @default(true)
  lastSyncAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Bitácora de auditoría de sincronización — no es la cola de trabajo (eso
// lo maneja BullMQ/Redis, ver apps/api/src/woocommerce/woo-queue.service.ts):
// cada job de BullMQ crea su fila acá al encolarse (status=PENDING) y la
// actualiza a SUCCESS/FAILED al terminar, así que esta tabla siempre queda
// como el historial consultable desde el panel de integración, sobreviva o
// no el job en Redis.
model SyncLog {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  entityType   SyncEntityType
  direction    SyncDirection
  status       SyncStatus     @default(PENDING)
  payload      Json
  errorMessage String?
  createdAt    DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

// ──────────────────────────────────────────────────────────────────────────
// SEGURIDAD (Sprint 9)
// ──────────────────────────────────────────────────────────────────────────

// Sin tenantId/RLS a propósito — mismo motivo que el bypass de login sobre
// User (ver withAuthLookupContext): rotar/revocar un refresh token pasa por
// buscarlo por tokenHash, y SUPERADMIN (sin tenant) también emite/rota
// tokens. tokenHash es SHA-256 del JWT (no bcrypt): necesita ser una
// búsqueda exacta por índice, no una comparación 1 a 1 contra cada fila —
// el propio JWT ya es criptográficamente aleatorio, así que un hash rápido
// alcanza para no guardar el token en texto plano sin pagar el costo de
// bcrypt en cada refresh.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Auditoría de mutaciones sensibles (ajuste de stock, anulación de venta,
// alta de usuario, y lo que sigan agregando las próximas fases: cobro de
// cuenta corriente, precios en lote, compras). `action` es un string libre
// (con una unión de constantes del lado de TS en @pos/shared-types), no un
// enum de Postgres — así una acción nueva no exige una migración.
// userEmail queda "congelado" (no solo el FK a User) para que el historial
// se pueda seguir leyendo aunque el usuario se borre o cambie de email.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  storeId    String?
  userId     String?
  userEmail  String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

// ──────────────────────────────────────────────────────────────────────────
// PROVEEDORES Y COMPRAS
// ──────────────────────────────────────────────────────────────────────────

model Supplier {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  name      String
  taxId     String?
  email     String?
  phone     String?
  address   String?
  isActive  Boolean    @default(true)
  purchases Purchase[]
  createdAt DateTime   @default(now())

  @@index([tenantId])
}

// purchaseNumber es secuencial por (tenantId, storeId) — mismo truco MAX+1
// dentro de la transacción + reintento ante P2002 que Order.orderNumber
// (ver PurchasesService.create). No es un comprobante fiscal — invoiceNumber
// es el número de factura/remito del proveedor, texto libre sin validar.
//
// Costo: "último costo" — cada línea actualiza Product.costPrice (o
// ProductVariant.costPrice) al costo unitario de esta compra, en la misma
// transacción. El costo promedio ponderado sería más correcto para margen
// pero exige repartir stock entre locales y decidir qué pasa al anular una
// compra — deliberadamente fuera de v1 (ver plan de mejoras, Fase 7).
model Purchase {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  storeId        String
  store          Store          @relation(fields: [storeId], references: [id])
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  purchaseNumber Int
  invoiceNumber  String?
  total          Decimal        @db.Decimal(12, 2)
  notes          String?
  items          PurchaseItem[]
  createdAt      DateTime       @default(now())

  @@unique([tenantId, storeId, purchaseNumber])
  @@index([tenantId, storeId, createdAt])
}

model PurchaseItem {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  purchaseId  String
  purchase    Purchase        @relation(fields: [purchaseId], references: [id])
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String
  sku         String
  quantity    Decimal         @db.Decimal(12, 3)
  unitCost    Decimal         @db.Decimal(12, 2)
  subtotal    Decimal         @db.Decimal(12, 2)

  @@index([tenantId, purchaseId])
}

// ──────────────────────────────────────────────────────────────────────────
// SUSCRIPCIÓN / FACTURACIÓN DEL SAAS
// ──────────────────────────────────────────────────────────────────────────

// Historial de facturación: la respuesta a "¿por qué este comercio está en
// este estado?". Imprescindible ante un reclamo ("yo pagué"), porque guarda
// el payload crudo que mandó Mercado Pago.
//
// mpPaymentId es @unique y ESA es la idempotencia del webhook: Mercado Pago
// reintenta las notificaciones, y sin esta restricción el mismo pago
// extendería currentPeriodEnd dos veces. El P2002 que tira el segundo
// intento se atrapa y se ignora (ver SubscriptionService.applyPayment).
model SubscriptionEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  type        String // 'mp.subscription_preapproval' | 'mp.payment' | 'manual.extend' | ...
  status      String
  amount      Decimal? @db.Decimal(12, 2)
  mpPaymentId String?  @unique
  periodEnd   DateTime? // a qué fecha quedó movido currentPeriodEnd
  notes       String?
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ──────────────────────────────────────────────────────────────────────────
// TIENDA NUBE
// ──────────────────────────────────────────────────────────────────────────

// A diferencia de WooCommerce —donde el comerciante pega una clave y un
// secreto— Tienda Nube usa OAuth 2: el comercio autoriza por redirección y
// nosotros recibimos un token que NO vence (solo muere si desinstalan la
// app). Por eso acá no hay consumerKey/consumerSecret: hay un accessToken.
//
// El accessToken se guarda CIFRADO con EncryptionService, igual que las
// credenciales de AFIP: con él se puede operar la tienda del cliente
// (cambiar precios, stock), así que un dump de la base no puede exponerlo.
//
// tnStoreId es el id de la tienda del lado de ellos, que viene junto al
// token en el intercambio de OAuth. Sin ese id no se puede llamar a su API,
// porque todas las rutas lo llevan en el path.
model TiendanubeConfig {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  storeId           String    @unique
  store             Store     @relation(fields: [storeId], references: [id])
  tnStoreId         String
  accessToken       String    @db.Text
  scopes            String?
  syncStockOutbound Boolean   @default(true)
  syncStockInbound  Boolean   @default(true)
  // Igual que en WooCommerce: el precio solo va del POS hacia la tienda. No
  // tiene sentido un "inbound" simétrico — el precio de venta lo define el
  // punto de venta, no el canal online.
  syncPriceOutbound Boolean   @default(true)
  isActive          Boolean   @default(true)
  lastSyncAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}
