# Copiar a .env y ajustar. Nunca commitear .env real.
#
# Para desarrollo local nativo (pnpm dev) o con docker-compose.dev.yml
# (Postgres/Redis en localhost), los defaults de acá ya alcanzan.
# Para docker-compose.prod.yml, completar los secretos marcados abajo — el
# compose falla explícito al arrancar si falta alguno "requerido".

# ──────────────────────────────────────────────────────────────────────────
# Base de datos (packages/database) — Postgres
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://pos:pos@localhost:5432/pos_saas?schema=public"
# Usados solo por docker-compose.prod.yml para levantar el contenedor de
# Postgres — deben coincidir con lo que DATABASE_URL apunta arriba.
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos_saas

# ──────────────────────────────────────────────────────────────────────────
# Redis / BullMQ (AFIP + WooCommerce corren sus colas acá)
# ──────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────────────────────────────────
# apps/api — Auth y seguridad (Sprint 9)
# ──────────────────────────────────────────────────────────────────────────
# REQUERIDO en producción — un secreto real, largo y aleatorio (ej. `openssl
# rand -base64 48`). Firma los access tokens (15 min de vida).
JWT_ACCESS_SECRET="dev-access-secret-change-me"
# REQUERIDO en producción — distinto del de arriba. Firma los refresh
# tokens (7 días, con rotación + detección de reuso — ver RefreshToken en
# schema.prisma y AuthService).
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
PORT=3001
# Orígenes permitidos por CORS, separados por coma (sin espacios extra
# necesarios, se recortan igual). Sin esta variable, cae a
# http://localhost:3000 — NO a "*" (no es válido junto con credentials:true,
# que este API necesita para el header Authorization).
CORS_ORIGIN="http://localhost:3000"

# ──────────────────────────────────────────────────────────────────────────
# apps/api — Facturación electrónica AFIP (Sprint 6)
# ──────────────────────────────────────────────────────────────────────────
# AFIP_MOCK=true usa AfipMockGateway en vez del SOAP real (sin certificados
# de homologación a mano). Las credenciales reales (CUIT, certificado, clave
# privada) se cargan por local desde /fiscal-config, no acá.
AFIP_MOCK=false

# ──────────────────────────────────────────────────────────────────────────
# apps/api — Integración WooCommerce (Sprint 7)
# ──────────────────────────────────────────────────────────────────────────
# URL pública donde corre esta API — se usa para armar la URL de webhook de
# WooCommerce que se muestra en /settings/integrations/woocommerce.
API_PUBLIC_URL="http://localhost:3001"
# WOO_MOCK=true usa WooMockGateway en vez de la REST API real de WooCommerce.
WOO_MOCK=false
# Máximo de requests/segundo hacia la API REST de WooCommerce (no saturar
# hostings compartidos de WordPress).
WOO_RATE_LIMIT_PER_SEC=5

# ──────────────────────────────────────────────────────────────────────────
# apps/pos-web
# ──────────────────────────────────────────────────────────────────────────
# En Docker (apps/pos-web/Dockerfile) esta variable se hornea en el bundle
# de cliente EN BUILD TIME (--build-arg), no sirve seteada solo en runtime —
# ver el comentario al principio de ese Dockerfile.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ──────────────────────────────────────────────────────────────────────────
# apps/api — Suscripción del SaaS (cobro mensual a los comercios)
# ──────────────────────────────────────────────────────────────────────────
# Credenciales TUYAS (del vendedor del software), no de cada comercio: hay
# una sola cuenta de Mercado Pago cobrando todas las suscripciones. Por eso
# van acá y no en la base de datos.
#
# MP_ACCESS_TOKEN: Mercado Pago → Tus integraciones → tu aplicación →
#   Credenciales. Usar las de PRUEBA para testear y las de producción recién
#   al salir en vivo.
# MP_WEBHOOK_SECRET: se genera al guardar la configuración de Webhooks en esa
#   misma pantalla. Sin esto, la API rechaza TODOS los webhooks (no hay forma
#   de distinguir uno real de uno falsificado).
#   URL a configurar allí: <API_PUBLIC_URL>/webhooks/mercadopago
#   Temas a habilitar: subscription_preapproval, subscription_authorized_payment, payments
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# URL pública del frontend — a donde vuelve el comercio después de adherir la
# tarjeta en Mercado Pago.
APP_PUBLIC_URL="http://localhost:3000"

# Días de prueba gratis para un comercio recién dado de alta.
BILLING_TRIAL_DAYS=30
# Días después del vencimiento antes de considerarlo vencido de verdad. Con
# la política por defecto (WARN_ONLY) esto solo cambia el tono del aviso.
BILLING_GRACE_DAYS=10
# Cuántos días antes del vencimiento se empieza a mostrar el banner.
BILLING_WARN_BEFORE_DAYS=7

# ──────────────────────────────────────────────────────────────────────────
# apps/api — Demo pública (landing "/", POST /demo/start)
# ──────────────────────────────────────────────────────────────────────────

# Tope de tenants demo VIVOS a la vez (planTier=demo, sin vencer). Es la
# única defensa real contra que el pool crezca sin límite, dado que
# POST /demo/start es anónimo — ver DemoService.assertUnderCap.
DEMO_MAX_LIVE=200
# Días entre que un tenant demo se BLOQUEA (a los 7 días de creado, fijo, ver
# DEMO_LIFETIME_MS en demo.service.ts) y que se BORRA de verdad si nadie
# pagó. Es una ventana de negocio (placeholder 60), no un detalle técnico —
# ajustable sin tocar código. Ver DemoPurgeService.
DEMO_PURGE_GRACE_DAYS=60

# ──────────────────────────────────────────────────────────────────────────
# apps/api — Mensajes de soporte / venta (botón flotante, cartel Premium)
# ──────────────────────────────────────────────────────────────────────────

# Sin estas 4 variables, los mensajes se siguen guardando y viéndose en
# /platform/support-messages — solo no se manda el mail de aviso (ver el
# comentario en support-mailer.service.ts, no hay mailer configurado en este
# repo por defecto).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# A dónde llega el aviso de un mensaje nuevo (duda técnica o interés en Premium).
SUPPORT_NOTIFY_EMAIL=

# ──────────────────────────────────────────────────────────────────────────
# apps/api — Cifrado en reposo de credenciales fiscales
# ──────────────────────────────────────────────────────────────────────────
# Clave maestra AES-256-GCM con la que se cifran el certificado y la CLAVE
# PRIVADA de AFIP antes de guardarlos en FiscalConfig. Sin esto, un dump de
# la base expone la capacidad de facturar a nombre de todos los comercios.
#
# Generar con:  openssl rand -hex 32
#
# SI SE PIERDE, las credenciales guardadas son irrecuperables y hay que
# volver a cargar los certificados de cada comercio. Guardarla aparte del
# backup de la base — si viajan juntos, el cifrado no sirve de nada.
ENCRYPTION_KEY=""

# ──────────────────────────────────────────────────────────────────────────
# apps/api — Integración Tienda Nube
# ──────────────────────────────────────────────────────────────────────────
# Se obtienen creando una aplicación en https://partners.tiendanube.com
# (hay que registrarse como partner primero). El "App ID" es el CLIENT_ID.
#
# En el panel de la aplicación, en la sección URLs, van así:
#   Página de la aplicación .............. <APP_PUBLIC_URL>/settings/integrations/tiendanube
#   URL para redirigir después de la
#   instalación (redirect URI) ........... <API_PUBLIC_URL>/integrations/tiendanube/callback
#
# El `code` de OAuth llega SIEMPRE a la URL de redirección, nunca a la
# página de la aplicación — invertirlas es el error típico y hace que la
# conexión termine en el panel de Tienda Nube en vez de en el POS.
TIENDANUBE_CLIENT_ID=""
# El secreto de la app. Además de canjear el código de OAuth, es la clave con
# la que Tienda Nube firma los webhooks (HMAC-SHA256, header
# x-linkedstore-hmac-sha256): sin esto la API los rechaza todos.
TIENDANUBE_CLIENT_SECRET=""
# Tienda Nube exige un User-Agent identificable con un mail de contacto real;
# si falta, rechazan las llamadas.
TIENDANUBE_CONTACT_EMAIL=""
# true = usar el simulador en memoria en vez de la API real. Es lo que permite
# probar la integración entera sin esperar a que aprueben la app de partner.
TIENDANUBE_MOCK="false"
# Llamadas por segundo hacia su API (el worker las limita). 2 deja margen.
TIENDANUBE_RATE_LIMIT_PER_SEC=2
