# Copiar a .env y ajustar. Nunca commitear .env real.
#
# Para desarrollo local nativo (pnpm dev) o con docker-compose.dev.yml
# (Postgres/Redis en localhost), los defaults de acá ya alcanzan.
# Para docker-compose.prod.yml, completar los secretos marcados abajo — el
# compose falla explícito al arrancar si falta alguno "requerido".

# ──────────────────────────────────────────────────────────────────────────
# Base de datos (packages/database) — Postgres
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://pos:pos@localhost:5432/pos_saas?schema=public"
# Usados solo por docker-compose.prod.yml para levantar el contenedor de
# Postgres — deben coincidir con lo que DATABASE_URL apunta arriba.
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos_saas

# ──────────────────────────────────────────────────────────────────────────
# Redis / BullMQ (AFIP + WooCommerce corren sus colas acá)
# ──────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────────────────────────────────
# apps/api — Auth y seguridad (Sprint 9)
# ──────────────────────────────────────────────────────────────────────────
# REQUERIDO en producción — un secreto real, largo y aleatorio (ej. `openssl
# rand -base64 48`). Firma los access tokens (15 min de vida).
JWT_ACCESS_SECRET="dev-access-secret-change-me"
# REQUERIDO en producción — distinto del de arriba. Firma los refresh
# tokens (7 días, con rotación + detección de reuso — ver RefreshToken en
# schema.prisma y AuthService).
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
PORT=3001
# Orígenes permitidos por CORS, separados por coma (sin espacios extra
# necesarios, se recortan igual). Sin esta variable, cae a
# http://localhost:3000 — NO a "*" (no es válido junto con credentials:true,
# que este API necesita para el header Authorization).
CORS_ORIGIN="http://localhost:3000"

# ──────────────────────────────────────────────────────────────────────────
# apps/api — Facturación electrónica AFIP (Sprint 6)
# ──────────────────────────────────────────────────────────────────────────
# AFIP_MOCK=true usa AfipMockGateway en vez del SOAP real (sin certificados
# de homologación a mano). Las credenciales reales (CUIT, certificado, clave
# privada) se cargan por local desde /fiscal-config, no acá.
AFIP_MOCK=false

# ──────────────────────────────────────────────────────────────────────────
# apps/api — Integración WooCommerce (Sprint 7)
# ──────────────────────────────────────────────────────────────────────────
# URL pública donde corre esta API — se usa para armar la URL de webhook de
# WooCommerce que se muestra en /settings/integrations/woocommerce.
API_PUBLIC_URL="http://localhost:3001"
# WOO_MOCK=true usa WooMockGateway en vez de la REST API real de WooCommerce.
WOO_MOCK=false
# Máximo de requests/segundo hacia la API REST de WooCommerce (no saturar
# hostings compartidos de WordPress).
WOO_RATE_LIMIT_PER_SEC=5

# ──────────────────────────────────────────────────────────────────────────
# apps/pos-web
# ──────────────────────────────────────────────────────────────────────────
# En Docker (apps/pos-web/Dockerfile) esta variable se hornea en el bundle
# de cliente EN BUILD TIME (--build-arg), no sirve seteada solo en runtime —
# ver el comentario al principio de ese Dockerfile.
NEXT_PUBLIC_API_URL="http://localhost:3001"
