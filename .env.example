# Copiar a .env y ajustar. Nunca commitear .env real.

# packages/database
DATABASE_URL="postgresql://pos:pos@localhost:5432/pos_saas?schema=public"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# apps/api
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
PORT=3001
# URL pública donde corre esta API — se usa para armar la URL de webhook de
# WooCommerce que se muestra en /settings/integrations/woocommerce.
API_PUBLIC_URL="http://localhost:3001"
# AFIP_MOCK=true usa AfipMockGateway en vez del SOAP real (sin certificados).
AFIP_MOCK=false
# WOO_MOCK=true usa WooMockGateway en vez de la REST API real de WooCommerce.
WOO_MOCK=false
# Máximo de requests/segundo hacia la API REST de WooCommerce (no saturar
# hostings compartidos de WordPress).
WOO_RATE_LIMIT_PER_SEC=5

# apps/pos-web
NEXT_PUBLIC_API_URL="http://localhost:3001"
